# ===========================================
# Azure GPT-Realtime Configuration
# ===========================================
# Get these from your Azure OpenAI resource
AZURE_API_KEY=your_azure_openai_api_key
AZURE_HOST=your-resource-name.openai.azure.com
AZURE_DEPLOYMENT=gpt-realtime
AZURE_API_VERSION=2024-10-01-preview

# Optional: Provide full endpoint to override above settings
# AZURE_REALTIME_ENDPOINT=wss://your-host.openai.azure.com/openai/realtime?api-version=2024-10-01-preview&deployment=gpt-realtime

# ===========================================
# Twilio WhatsApp Configuration (Optional)
# ===========================================
# Get these from your Twilio Console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# Database Configuration
# ===========================================
# For SQLite (default - no config needed)
# For PostgreSQL (production recommended):
# DATABASE_URL=postgresql://user:password@localhost:5432/clinic_db

# ===========================================
# Application Settings
# ===========================================
DEBUG_MODE=false
LOG_LEVEL=INFO
TEST_MODE=false

# ===========================================
# Audio Processing
# ===========================================
SILENCE_THRESHOLD_FRACTION=0.02
AUDIO_MAX_BUFFER_SECONDS=5.0
