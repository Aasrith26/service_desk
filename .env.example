# Clinic Voice Assistant - Backend Environment Variables
# ======================================================
# Copy this file to .env and fill in your values

# Database Connection (Railway PostgreSQL)
# Use DATABASE_PUBLIC_URL for external access
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@tramway.proxy.rlwy.net:54361/railway

# Azure OpenAI Realtime API (for voice agent)
AZURE_REALTIME_ENDPOINT=wss://your-resource.openai.azure.com/openai/realtime
AZURE_API_KEY=your-azure-api-key

# Twilio (for voice calls)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token

# Exotel (if using Exotel instead of Twilio)
EXOTEL_API_KEY=your-exotel-key
EXOTEL_API_TOKEN=your-exotel-token

# Optional: WhatsApp Business API
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=
